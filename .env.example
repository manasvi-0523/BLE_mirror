# Ethereum / Sepolia testnet configuration
# Copy this file to .env and fill in your values.
# .env is gitignored - never commit real keys.

# Step 1: Get a free RPC endpoint
#   Infura:   https://app.infura.io  -> Create project -> Endpoints -> Sepolia
#   Alchemy:  https://dashboard.alchemy.com -> Create App -> Sepolia
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Step 2: Deploy BLETrustRegistry.sol on Remix (https://remix.ethereum.org)
#   - Open contracts/BLETrustRegistry.sol, compile with Solidity 0.8.19
#   - Deploy to Sepolia via MetaMask (Injected Web3 provider)
#   - Paste the deployed address here
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Step 3: Export your MetaMask private key (admin account only - keep secret!)
#   MetaMask -> Account -> Account Details -> Export Private Key
ETH_PRIVATE_KEY=your_hex_private_key_without_0x_prefix

# Quick-start: get free Sepolia ETH
#   https://sepoliafaucet.com
#   https://faucet.quicknode.com/ethereum/sepolia
